  "dependencies": {
    "aws4": "^1.12.0",
    "fastify-plugin": "^6.0.0"
  },
  "devDependencies": {
    "@types/aws4": "^1.11.6",
    "@types/node": "^26.2.0",
    "fastify": "^5.0.0",
    "fastify-raw-body": "^6.0.1",
    "tsx": "^4.0.0",
    "typescript": "^7.0.2"
  }
