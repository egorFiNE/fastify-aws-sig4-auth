{
  "name": "fastify-aws-sig4-auth",
  "version": "0.0.1",
  "description": "Protect fastify routes using AWS Signature V4",
  "keywords": [
    "fastify",
    "aws",
    "aws-signature-v4",
    "sigv4",
    "authentication"
  ],
  "homepage": "https://github.com/egorFiNE/fastify-aws-sig4-auth",
  "author": {
    "name": "Egor Egorov",
    "email": "me@egorfine.com",
    "url": "https://egorfine.com/en/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/egorFiNE/fastify-aws-sig4-auth.git"
  },
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
